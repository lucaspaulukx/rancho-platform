@@ -0,0 +1,49 @@
+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+/** Fixed return and issuer-bound destination; no browser-supplied redirect or ID token. */
+public final class OidcLogoutRules {
+    private OidcLogoutRules() { }
+    private static URI web(String value, boolean allowHttp) throws Exception {
+        URI uri = new URI(value);
+        if (uri.getHost() == null || uri.getRawUserInfo() != null || uri.getRawFragment() != null ||
+            !("https".equalsIgnoreCase(uri.getScheme()) || (allowHttp && "http".equalsIgnoreCase(uri.getScheme())))) {
+            throw new IllegalArgumentException("Invalid logout URL");
+        }
+        return uri;
+    }
+    private static int port(URI uri) { return uri.getPort() >= 0 ? uri.getPort() : "https".equalsIgnoreCase(uri.getScheme()) ? 443 : 80; }
+    private static boolean sameOrigin(URI a, URI b) {
+        return a.getScheme().equalsIgnoreCase(b.getScheme()) && a.getHost().equalsIgnoreCase(b.getHost()) && port(a) == port(b);
+    }
+    public static boolean requestAllowed(String origin, String callback, String cookie, String header, boolean allowHttp) {
+        try {
+            URI source = web(origin, allowHttp), target = web(callback, allowHttp);
+            if (!sameOrigin(source, target) || source.getRawQuery() != null || !source.getRawPath().isEmpty()) { return false; }
+            return cookie != null && header != null && !cookie.isEmpty() && cookie.length() <= 4096 &&
+                MessageDigest.isEqual(cookie.getBytes(StandardCharsets.UTF_8), header.getBytes(StandardCharsets.UTF_8));
+        } catch (Exception invalid) { return false; }
+    }
+    public static String destination(String endpoint, String issuer, String callback, String client, boolean allowHttp) throws Exception {
+        URI logout = web(endpoint, allowHttp), provider = web(issuer, allowHttp), app = web(callback, allowHttp);
+        if (!sameOrigin(logout, provider) || client == null || client.trim().isEmpty() || client.length() > 1024) {
+            throw new IllegalArgumentException("Invalid logout destination");
+        }
+        if (logout.getRawQuery() != null) {
+            for (String pair : logout.getRawQuery().split("&")) {
+                String key = URLDecoder.decode(pair.split("=", 2)[0], "UTF-8");
+                if ("client_id".equals(key) || "post_logout_redirect_uri".equals(key) || "id_token_hint".equals(key) || "logout_hint".equals(key)) {
+                    throw new IllegalArgumentException("Conflicting logout parameters");
+                }
+            }
+        }
+        String returned = new URI(app.getScheme(), null, app.getHost(), app.getPort(), "/console/login", "oidc_logout=returned", null).toASCIIString();
+        return logout.toASCIIString() + (logout.getRawQuery() == null ? "?" : "&") +
+            "client_id=" + URLEncoder.encode(client, "UTF-8") + "&post_logout_redirect_uri=" + URLEncoder.encode(returned, "UTF-8");
+    }
+}
diff --git a/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcReadiness.java b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcReadiness.java
new file mode 100644
--- /dev/null
+++ b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcReadiness.java
@@ -0,0 +1,29 @@
+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import java.util.concurrent.Callable;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.LongSupplier;
+
+/** Short, bounded availability probe; never caches authentication data. */
+public final class OidcReadiness {
+    private final long ttl;
+    private final LongSupplier clock;
+    private final AtomicBoolean running = new AtomicBoolean();
+    private volatile long validUntil = Long.MIN_VALUE;
+    private volatile boolean ready;
+    public OidcReadiness(long ttl) { this(ttl, () -> TimeUnit.NANOSECONDS.toMillis(System.nanoTime())); }
+    public OidcReadiness(long ttl, LongSupplier clock) { this.ttl = ttl; this.clock = clock; }
+    public boolean check(Callable<Boolean> probe) {
+        if (clock.getAsLong() < validUntil) { return ready; }
+        if (!running.compareAndSet(false, true)) { return false; }
+        try {
+            if (clock.getAsLong() < validUntil) { return ready; }
+            try { ready = Boolean.TRUE.equals(probe.call()); }
+            catch (InterruptedException interrupted) { Thread.currentThread().interrupt(); ready = false; }
+            catch (Exception unavailable) { ready = false; }
+            validUntil = clock.getAsLong() + ttl;
+            return ready;
+        } finally { running.set(false); }
+    }
+}
diff --git a/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcServlet.java b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcServlet.java
