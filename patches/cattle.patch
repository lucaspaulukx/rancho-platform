+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.crypto.RSASSAVerifier;
+import com.nimbusds.jose.jwk.*;
+import com.nimbusds.jwt.*;
+import io.cattle.platform.core.model.Account;
+import io.cattle.platform.iaas.api.auth.dao.AuthDao;
+import io.cattle.platform.object.ObjectManager;
+import io.cattle.platform.object.process.ObjectProcessManager;
+import io.cattle.platform.object.process.StandardProcess;
+import io.github.ibuildthecloud.gdapi.exception.ClientVisibleException;
+import java.io.*;
+import java.net.*;
+import java.nio.charset.StandardCharsets;
+import java.security.*;
+import java.util.*;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.inject.Inject;
+import javax.servlet.http.*;
+
+/** OIDC authenticates only. All environment grants remain local to Rancher. */
+public class OidcSupport {
+    @Inject LocalGroupStore localGroupStore;
+    @Inject AuthDao authDao;
+    @Inject io.cattle.platform.iaas.api.auth.dao.AuthTokenDao authTokenDao;
+    @Inject io.cattle.platform.core.dao.AccountDao accountDao;
+    @Inject io.cattle.platform.token.TokenService tokenService;
+    @Inject ObjectManager objectManager;
+    @Inject ObjectProcessManager objectProcessManager;
+    private final ObjectMapper mapper=new ObjectMapper();
+    private final SecureRandom random=new SecureRandom();
+    private final Map<String,Flow> flows=new ConcurrentHashMap<>();
+    private final Map<String,Ticket> tickets=new ConcurrentHashMap<>();
+    private final String issuer=System.getenv("RANCHER_OIDC_ISSUER");
+    private final String client=System.getenv("RANCHER_OIDC_CLIENT_ID");
+    private final String secret=System.getenv("RANCHER_OIDC_CLIENT_SECRET");
+    private final String callback=System.getenv("RANCHER_OIDC_CALLBACK");
+    private final String backchannel=System.getenv("RANCHER_OIDC_BACKCHANNEL");
+    private volatile Map<String,Object> metadata;
+    private final OidcReadiness readiness=new OidcReadiness(1000);
+
+    @javax.annotation.PostConstruct
+    public void validateConfiguration() { CustomizationConfig.CURRENT.publicConfig(); }
+    public boolean enabled() { return CustomizationConfig.CURRENT.enabled("OIDC_ENABLED"); }
+    public boolean only() { return CustomizationConfig.CURRENT.enabled("OIDC_ONLY"); }
+    public boolean autoLogin() { return CustomizationConfig.CURRENT.enabled("OIDC_AUTO_LOGIN"); }
+    public boolean loginPreflightEnabled() { return CustomizationConfig.CURRENT.enabled("OIDC_LOGIN_PREFLIGHT_ENABLED"); }
+    public boolean loginReady() {
+        if (!enabled()) { return false; }
+        if (!loginPreflightEnabled()) { return true; }
+        return readiness.check(() -> {
+            Map<String,Object> fresh=json(issuer+"/.well-known/openid-configuration",null);
+            if (!issuer.equals(fresh.get("issuer")) || !(fresh.get("authorization_endpoint") instanceof String)) { return false; }
+            URI authorization=new URI((String)fresh.get("authorization_endpoint"));
+            if (authorization.getHost()==null || authorization.getUserInfo()!=null || authorization.getFragment()!=null) { return false; }
+            endpoint((String)fresh.get("authorization_endpoint"));
+            metadata=fresh;
+            return true;
+        });
+    }
+    public boolean federatedLogoutEnabled() { return CustomizationConfig.CURRENT.enabled("OIDC_FEDERATED_LOGOUT_ENABLED"); }
+    private String cookie(HttpServletRequest request, String name) {
+        if (request.getCookies() != null) {
+            for (Cookie cookie : request.getCookies()) { if (name.equals(cookie.getName())) { return cookie.getValue(); } }
+        }
+        return null;
+    }
+    public Map<String,Object> prepareLogout(HttpServletRequest request) throws Exception {
+        if (!federatedLogoutEnabled()) { throw new ClientVisibleException(404,"FeatureDisabled"); }
+        boolean allowHttp = "true".equals(System.getenv("RANCHER_LAB_ALLOW_HTTP"));
+        if (!OidcLogoutRules.requestAllowed(request.getHeader("Origin"), callback, cookie(request,"CSRF"), request.getHeader("X-Api-Csrf"), allowHttp)) {
+            throw new ClientVisibleException(403,"LogoutRequestRejected");
+        }
+        String key = cookie(request,"token");
+        io.cattle.platform.core.model.AuthToken stored = key == null ? null : authTokenDao.getTokenByKey(key);
+        if (stored == null || !io.cattle.platform.iaas.api.auth.SecurityConstants.AUTH_PROVIDER.get().equals(stored.getProvider())) {
+            throw new ClientVisibleException(401,"SessionUnavailable");
+        }
+        Map<String,Object> payload;
+        try { payload = tokenService.getJsonPayload(stored.getValue(),true); }
+        catch (io.cattle.platform.token.TokenException invalid) { throw new ClientVisibleException(401,"SessionUnavailable"); }
+        Account account = stored.getAuthenticatedAsAccountId() == null ? null : authDao.getAccountById(stored.getAuthenticatedAsAccountId());
+        if (payload == null || account == null || !accountDao.isActiveAccount(account)) { throw new ClientVisibleException(401,"SessionUnavailable"); }
+        Map<String,Object> result = new LinkedHashMap<>();
+        if (!"oidc".equals(payload.get("loginMethod"))) { result.put("federated",false); return result; }
+        // Fresh discovery, with bounded connect/read deadlines; never return cached success for an unavailable IdP.
+        Map<String,Object> fresh = json(issuer+"/.well-known/openid-configuration",null);
+        if (!issuer.equals(fresh.get("issuer")) || !(fresh.get("end_session_endpoint") instanceof String)) { throw new IOException("Logout discovery unavailable"); }
+        String url = OidcLogoutRules.destination((String)fresh.get("end_session_endpoint"),issuer,callback,client,allowHttp);
+        result.put("federated",true); result.put("url",url);
+        return result;
+    }
+    private String randomString() { byte[] b=new byte[32]; random.nextBytes(b); return Base64.getUrlEncoder().withoutPadding().encodeToString(b); }
+    private String enc(String s) throws Exception { return URLEncoder.encode(s,"UTF-8"); }
+    private String hash(String s) throws Exception { return Base64.getUrlEncoder().withoutPadding().encodeToString(MessageDigest.getInstance("SHA-256").digest(s.getBytes(StandardCharsets.UTF_8))); }
+    private static class Flow { String browser,nonce,verifier; long expires; }
+    private static class Ticket { String browser,subject,name,identity; long expires; }
+
+    private void cleanup() {
+        long now=System.currentTimeMillis();
+        flows.entrySet().removeIf(e -> e.getValue().expires<now);
+        tickets.entrySet().removeIf(e -> e.getValue().expires<now);
+        if (flows.size()+tickets.size()>1000) { throw new ClientVisibleException(503,"TooManyLoginFlows"); }
+    }
+    private String browser(HttpServletRequest r) {
+        if (r.getCookies()!=null) { for (Cookie c:r.getCookies()) { if ("rancher_oidc_browser".equals(c.getName())) { return c.getValue(); } } }
+        return null;
+    }
+    private URL endpoint(String value) throws Exception {
+        URI uri=new URI(value);
+        if (!"https".equals(uri.getScheme()) && !("true".equals(System.getenv("RANCHER_LAB_ALLOW_HTTP")) && "http".equals(uri.getScheme()))) { throw new IllegalArgumentException("OIDC requires HTTPS"); }
+        if (backchannel!=null && value.startsWith(issuer+"/")) { value=backchannel+value.substring(issuer.length()); }
+        return new URL(value);
+    }
+    private Map<String,Object> json(String url,String form) throws Exception {
+        HttpURLConnection c=(HttpURLConnection)endpoint(url).openConnection();
+        c.setConnectTimeout(5000); c.setReadTimeout(10000); c.setInstanceFollowRedirects(false);
+        c.setRequestProperty("Accept","application/json");
+        try {
+            if (form!=null) {
+                c.setRequestMethod("POST"); c.setDoOutput(true); c.setRequestProperty("Content-Type","application/x-www-form-urlencoded");
+                try(OutputStream out=c.getOutputStream()) { out.write(form.getBytes(StandardCharsets.UTF_8)); }
+            }
+            if (c.getResponseCode()!=200) { throw new IOException("OIDC endpoint rejected request"); }
+            try(InputStream in=c.getInputStream()) { return mapper.readValue(in,Map.class); }
+        } finally { c.disconnect(); }
+    }
+    private synchronized Map<String,Object> metadata() throws Exception {
+        if (metadata==null) {
+            Map<String,Object> m=json(issuer+"/.well-known/openid-configuration",null);
+            if (!issuer.equals(m.get("issuer"))) { throw new IllegalArgumentException("Invalid discovery issuer"); }
+            metadata=m;
+        }
+        return metadata;
+    }
+    public void login(HttpServletRequest r,HttpServletResponse response) throws Exception {
+        if (!enabled()) { response.sendError(404); return; }
+        cleanup();
+        Flow f=new Flow(); f.browser=randomString(); f.nonce=randomString(); f.verifier=randomString(); f.expires=System.currentTimeMillis()+300000;
+        String state=randomString(); flows.put(state,f);
+        response.addHeader("Set-Cookie","rancher_oidc_browser="+f.browser+"; Path=/; HttpOnly; SameSite=Lax; Max-Age=300"+(callback.startsWith("https:")?"; Secure":""));
+        String auth=(String)metadata().get("authorization_endpoint");
+        endpoint(auth); // validate scheme before redirect
+        response.sendRedirect(auth+"?response_type=code&scope=openid%20profile%20email&client_id="+enc(client)+"&redirect_uri="+enc(callback)+"&state="+enc(state)+"&nonce="+enc(f.nonce)+"&code_challenge_method=S256&code_challenge="+enc(hash(f.verifier)));
+    }
+    public void callback(HttpServletRequest r,HttpServletResponse response) throws Exception {
+        cleanup();
+        String state=r.getParameter("state");
+        Flow f=state==null?null:flows.remove(state);
+        if (f==null || f.expires<System.currentTimeMillis() || !f.browser.equals(browser(r)) || r.getParameter("code")==null) { throw new ClientVisibleException(401,"InvalidOidcState"); }
+        Map<String,Object> m=metadata();
+        String form="grant_type=authorization_code&client_id="+enc(client)+"&redirect_uri="+enc(callback)+"&code="+enc(r.getParameter("code"))+"&code_verifier="+enc(f.verifier);
+        if (secret!=null && !secret.isEmpty()) { form+="&client_secret="+enc(secret); }
+        Map<String,Object> tokens=json((String)m.get("token_endpoint"),form);
+        SignedJWT jwt=SignedJWT.parse((String)tokens.get("id_token"));
+        if (!JWSAlgorithm.RS256.equals(jwt.getHeader().getAlgorithm())) { throw new IllegalArgumentException("Unsupported ID token algorithm"); }
+        JWKSet keys=JWKSet.parse(mapper.writeValueAsString(json((String)m.get("jwks_uri"),null)));
+        JWK key=keys.getKeyByKeyId(jwt.getHeader().getKeyID());
+        if (!(key instanceof RSAKey) || !jwt.verify(new RSASSAVerifier(((RSAKey)key).toRSAPublicKey()))) { throw new IllegalArgumentException("Invalid token signature"); }
+        JWTClaimsSet claims=jwt.getJWTClaimsSet();
+        long now=System.currentTimeMillis();
+        if (!issuer.equals(claims.getIssuer()) || !claims.getAudience().contains(client) || claims.getSubject()==null || claims.getSubject().isEmpty() || claims.getExpirationTime()==null || claims.getExpirationTime().getTime()<=now || claims.getIssueTime()==null || claims.getIssueTime().getTime()>now+30000 || !f.nonce.equals(claims.getStringClaim("nonce")) || (claims.getNotBeforeTime()!=null && claims.getNotBeforeTime().getTime()>now+30000) || (claims.getAudience().size()>1 && !client.equals(claims.getStringClaim("azp")))) { throw new IllegalArgumentException("Invalid token claims"); }
+        Ticket t=new Ticket(); t.browser=f.browser; t.subject=claims.getSubject(); t.identity=hash(issuer+"\n"+t.subject); t.name=claims.getStringClaim("preferred_username");
+        if (t.name==null || t.name.isEmpty()) { t.name=t.subject; }
+        t.expires=now+30000;
+        String ticket=randomString(); tickets.put(ticket,t);
+        response.sendRedirect("/login?oidc_ticket="+enc(ticket));
+    }
+    public synchronized Account consume(String ticket,HttpServletRequest r) {
+        Ticket t=tickets.remove(ticket);
+        if (t==null || t.expires<System.currentTimeMillis() || !t.browser.equals(browser(r))) { throw new ClientVisibleException(401,"InvalidOidcTicket"); }
+        Long accountId=localGroupStore.oidcAccount(t.identity);
+        if (accountId==null) {
+            // No email matching, admin promotion, password credential or environment provisioning.
+            Account account=authDao.createAccount(t.name,"user",t.identity,"oidc_subject");
+            objectProcessManager.executeStandardProcess(StandardProcess.CREATE,account,null);
+            account=objectManager.reload(account);
+            if ("inactive".equals(account.getState())) {
+                objectProcessManager.executeStandardProcess(StandardProcess.ACTIVATE,account,null);
+                account=objectManager.reload(account);
+            }
+            if (!"active".equals(account.getState())) { throw new ClientVisibleException(503,"AccountProvisioning"); }
+            localGroupStore.linkOidc(t.identity,account.getId());
+            return account;
+        }
+        Account account=authDao.getAccountById(accountId);
+        if (account==null || !"active".equals(account.getState()) || account.getRemoved()!=null) { throw new ClientVisibleException(401,"InactiveAccount"); }
+        return account;
+    }
+}
diff --git a/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/SessionGuardedWriter.java b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/SessionGuardedWriter.java
new file mode 100644
--- /dev/null
+++ b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/SessionGuardedWriter.java
@@ -0,0 +1,37 @@
+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import io.cattle.platform.api.pubsub.subscribe.MessageWriter;
+import java.io.IOException;
+
+/** Check immediately before each payload/ping; failures close without disclosing a reason. */
+public final class SessionGuardedWriter implements MessageWriter {
+    public interface Check { boolean allowed(); }
+    private final MessageWriter delegate;
+    private final Check check;
+    private boolean closed;
+
+    public SessionGuardedWriter(MessageWriter delegate, Check check) {
+        this.delegate = delegate;
+        this.check = check;
+    }
+
+    @Override
+    public synchronized void write(String message, Object writeLock) throws IOException {
+        if (closed) { throw new IOException("Subscription closed"); }
+        boolean allowed = false;
+        try { allowed = check.allowed(); } catch (RuntimeException unavailable) { /* Fail closed. */ }
+        if (!allowed) {
+            close();
+            throw new IOException("Subscription authorization unavailable");
+        }
+        delegate.write(message, writeLock);
+    }
+
+    @Override
+    public synchronized void close() {
+        if (!closed) {
+            closed = true;
+            delegate.close();
+        }
+    }
+}
