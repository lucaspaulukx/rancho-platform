+++ b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcServlet.java
@@ -0,0 +1,58 @@
+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import java.io.IOException;
+import javax.servlet.http.*;
+import org.springframework.web.context.support.WebApplicationContextUtils;
+
+public class OidcServlet extends HttpServlet {
+    protected void doGet(HttpServletRequest request,HttpServletResponse response) throws IOException {
+        response.setHeader("Cache-Control","no-store");
+        response.setHeader("Referrer-Policy","no-referrer");
+        response.setHeader("X-Content-Type-Options","nosniff");
+        OidcSupport oidc=WebApplicationContextUtils.getRequiredWebApplicationContext(getServletContext()).getBean(OidcSupport.class);
+        try {
+            String path=request.getPathInfo();
+            if ("/config".equals(path)) {
+                response.setContentType("application/json");
+                new com.fasterxml.jackson.databind.ObjectMapper().writeValue(response.getWriter(),CustomizationConfig.CURRENT.publicConfig());
+            } else if ("/status".equals(path)) {
+                response.setContentType("application/json"); response.getWriter().write("{\"enabled\":"+oidc.enabled()+",\"only\":"+oidc.only()+",\"autoLogin\":"+oidc.autoLogin()+",\"preflight\":"+oidc.loginPreflightEnabled()+"}");
+            } else if ("/readiness".equals(path)) {
+                boolean ready=oidc.loginReady();
+                response.setStatus(ready ? 200 : 503);
+                response.setContentType("application/json");
+                response.getWriter().write("{\"ready\":"+ready+",\"checked\":"+(oidc.enabled() && oidc.loginPreflightEnabled())+"}");
+            } else if ("/login".equals(path)) { oidc.login(request,response);
+            } else if ("/callback".equals(path) && oidc.enabled()) { oidc.callback(request,response);
+            } else { response.sendError(404); }
+        } catch (Exception e) {
+            // Never include authorization codes, tokens or client secrets in logs/errors.
+            StackTraceElement at=e.getStackTrace().length==0?null:e.getStackTrace()[0];
+            getServletContext().log("OIDC failure: "+e.getClass().getSimpleName()+" at "+at);
+            String failedPath=request.getPathInfo(),accept=request.getHeader("Accept");
+            if (oidc.loginPreflightEnabled() && ("/login".equals(failedPath) || "/callback".equals(failedPath)) &&
+                    accept!=null && accept.toLowerCase(java.util.Locale.ROOT).contains("text/html")) {
+                response.sendRedirect("/login?oidc_error=failed");
+                return;
+            }
+            response.sendError(401,"Falha na autenticacao OIDC. Inicie o login novamente.");
+        }
+    }
+    @Override
+    protected void doPost(HttpServletRequest request,HttpServletResponse response) throws IOException {
+        response.setHeader("Cache-Control","no-store");
+        response.setHeader("Referrer-Policy","no-referrer");
+        response.setHeader("X-Content-Type-Options","nosniff");
+        response.setContentType("application/json");
+        if (!"/logout".equals(request.getPathInfo())) { response.setStatus(404); response.getWriter().write("{}"); return; }
+        OidcSupport oidc=WebApplicationContextUtils.getRequiredWebApplicationContext(getServletContext()).getBean(OidcSupport.class);
+        try {
+            new com.fasterxml.jackson.databind.ObjectMapper().writeValue(response.getWriter(),oidc.prepareLogout(request));
+        } catch (io.github.ibuildthecloud.gdapi.exception.ClientVisibleException rejected) {
+            response.setStatus(rejected.getStatus()); response.getWriter().write("{\"error\":\"LogoutUnavailable\"}");
+        } catch (Exception unavailable) {
+            response.setStatus(503); response.getWriter().write("{\"error\":\"LogoutUnavailable\"}");
+        }
+    }
+
+}
