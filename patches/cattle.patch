@@ -0,0 +1,70 @@
+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import java.util.*;
+
+/** Server-owned, immutable configuration. Public output contains no credentials. */
+public final class CustomizationConfig {
+    public static final CustomizationConfig CURRENT = new CustomizationConfig(System.getenv());
+    private final Map<String,Boolean> requested = new LinkedHashMap<>();
+    private final Map<String,Boolean> effective = new LinkedHashMap<>();
+    private final boolean oidcConfigured;
+
+    public CustomizationConfig(Map<String,String> env) {
+        String[] names={"CUSTOMIZATION_ENABLED","LOCAL_RBAC_ENABLED","NO_ACCESS_VIEW_ENABLED",
+            "ENV_CREATION_ADMIN_ONLY","DISABLE_AUTO_ENVIRONMENT","CATALOG_WRITE_GUARD_ENABLED","SESSION_ACCOUNT_GUARD_ENABLED","SUBSCRIPTION_SESSION_GUARD_ENABLED","OIDC_ENABLED","OIDC_LOGIN_PREFLIGHT_ENABLED","OIDC_FEDERATED_LOGOUT_ENABLED","OIDC_ONLY","OIDC_AUTO_LOGIN","MODERN_UI_ENABLED"};
+        for (String name:names) {
+            boolean fallback=!(name.equals("OIDC_FEDERATED_LOGOUT_ENABLED") || name.equals("SUBSCRIPTION_SESSION_GUARD_ENABLED") || name.equals("OIDC_LOGIN_PREFLIGHT_ENABLED") || name.equals("OIDC_ONLY") || name.equals("OIDC_AUTO_LOGIN") || name.equals("MODERN_UI_ENABLED"));
+            String value=env.get("RANCHER_"+name);
+            if(value!=null && !value.equals("true") && !value.equals("false")) { throw new IllegalArgumentException("Invalid boolean: RANCHER_"+name); }
+            requested.put(name,value==null?fallback:Boolean.valueOf(value));
+        }
+        int configured=0;
+        for(String name:new String[]{"ISSUER","CLIENT_ID","CALLBACK"}) {
+            String value=env.get("RANCHER_OIDC_"+name);
+            if(value!=null && !value.trim().isEmpty()) { configured++; }
+        }
+        if(configured!=0 && configured!=3) { throw new IllegalArgumentException("Incomplete OIDC configuration"); }
+        oidcConfigured=configured==3;
+        String lab=env.get("RANCHER_LAB_ALLOW_HTTP");
+        if(lab!=null && !lab.equals("true") && !lab.equals("false")) { throw new IllegalArgumentException("Invalid boolean: RANCHER_LAB_ALLOW_HTTP"); }
+        if(oidcConfigured) {
+            for(String name:new String[]{"ISSUER","CALLBACK","BACKCHANNEL"}) {
+                String value=env.get("RANCHER_OIDC_"+name);
+                if(value==null || value.isEmpty()) { continue; }
+                try {
+                    java.net.URI uri=new java.net.URI(value);
+                    if(uri.getHost()==null || uri.getUserInfo()!=null || uri.getFragment()!=null || uri.getQuery()!=null ||
+                       !("https".equals(uri.getScheme()) || ("true".equals(lab) && "http".equals(uri.getScheme())))) {
+                        throw new IllegalArgumentException();
+                    }
+                } catch(Exception invalid) { throw new IllegalArgumentException("Invalid OIDC URL: RANCHER_OIDC_"+name); }
+            }
+        }
+        effective.putAll(requested);
+        boolean custom=requested.get("CUSTOMIZATION_ENABLED");
+        for(String name:new String[]{"LOCAL_RBAC_ENABLED","NO_ACCESS_VIEW_ENABLED","SUBSCRIPTION_SESSION_GUARD_ENABLED","OIDC_ENABLED"}) {
+            effective.put(name,custom && requested.get(name));
+        }
+        effective.put("OIDC_ENABLED",effective.get("OIDC_ENABLED") && oidcConfigured);
+        effective.put("OIDC_FEDERATED_LOGOUT_ENABLED",requested.get("OIDC_FEDERATED_LOGOUT_ENABLED") && effective.get("OIDC_ENABLED"));
+        effective.put("OIDC_LOGIN_PREFLIGHT_ENABLED",requested.get("OIDC_LOGIN_PREFLIGHT_ENABLED") && effective.get("OIDC_ENABLED"));
+        if((requested.get("OIDC_ONLY") || requested.get("OIDC_AUTO_LOGIN")) && !effective.get("OIDC_ENABLED")) {
+            throw new IllegalArgumentException("OIDC_ONLY/AUTO_LOGIN require effective OIDC");
+        }
+        if(requested.get("MODERN_UI_ENABLED")) { throw new IllegalArgumentException("Modern UI is not available in this build"); }
+    }
+    public boolean enabled(String name) { return Boolean.TRUE.equals(effective.get(name)); }
+    public Map<String,Object> publicConfig() {
+        Map<String,Object> result=new LinkedHashMap<>();
+        result.put("version",1);
+        result.put("requested",Collections.unmodifiableMap(requested));
+        result.put("effective",Collections.unmodifiableMap(effective));
+        Map<String,Boolean> available=new LinkedHashMap<>();
+        for(String key:requested.keySet()) { available.put(key,!key.equals("MODERN_UI_ENABLED")); }
+        available.put("OIDC_ENABLED",oidcConfigured);
+        available.put("OIDC_FEDERATED_LOGOUT_ENABLED",oidcConfigured);
+        available.put("OIDC_LOGIN_PREFLIGHT_ENABLED",oidcConfigured);
+        result.put("available",available);
+        return result;
+    }
+}
