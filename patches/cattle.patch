+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import io.cattle.platform.api.auth.Policy;
+import io.cattle.platform.api.auth.Identity;
+import io.cattle.platform.core.model.Account;
+import io.cattle.platform.core.model.ProjectMember;
+import io.cattle.platform.iaas.api.auth.SecurityConstants;
+import io.cattle.platform.iaas.api.auth.dao.AuthDao;
+import io.cattle.platform.iaas.api.auth.dao.impl.AuthDaoImpl;
+import io.cattle.platform.util.type.CollectionUtils;
+import io.github.ibuildthecloud.gdapi.context.ApiContext;
+import io.github.ibuildthecloud.gdapi.exception.ClientVisibleException;
+import io.github.ibuildthecloud.gdapi.factory.SchemaFactory;
+import io.github.ibuildthecloud.gdapi.model.ListOptions;
+import io.github.ibuildthecloud.gdapi.request.ApiRequest;
+import io.github.ibuildthecloud.gdapi.request.resource.impl.AbstractNoOpResourceManager;
+import java.util.*;
+import javax.inject.Inject;
+
+public class LocalGroupManager extends AbstractNoOpResourceManager {
+    @Inject LocalGroupStore localGroupStore;
+    @Inject AuthDao authDao;
+    public Class<?>[] getTypeClasses() { return new Class<?>[]{LocalGroup.class,LocalGroupAudit.class,LocalAccess.class}; }
+    private Policy policy() {
+        if (!CustomizationConfig.CURRENT.enabled("LOCAL_RBAC_ENABLED")) { throw new ClientVisibleException(404,"FeatureDisabled"); }
+        Policy p=(Policy)ApiContext.getContext().getPolicy();
+        if (!SecurityConstants.SECURITY.get() || p == null || p.getAuthenticatedAsAccountId() < 1) { throw new ClientVisibleException(403,"AuthenticationRequired"); }
+        return p;
+    }
+    private Policy admin() {
+        Policy p=policy();
+        if (!p.isOption(Policy.AUTHORIZED_FOR_ALL_ACCOUNTS)) { throw new ClientVisibleException(403,"AdminRequired"); }
+        return p;
+    }
+    protected Object listInternal(SchemaFactory factory,String type,Map<Object,Object> criteria,ListOptions options) {
+        if ("localAccessReport".equals(type)) {
+            Policy p=policy();
+            boolean administrative=p.isOption(Policy.AUTHORIZED_FOR_ALL_ACCOUNTS);
+            ApiRequest request = ApiContext.getContext().getApiRequest();
+            String targetAccount = parameter(request,"targetAccount");
+            long accountId = "self".equals(targetAccount) ? p.getAuthenticatedAsAccountId() : parseId(targetAccount);
+            long projectId = parseId(parameter(request,"targetEnvironment"));
+            if (!administrative && (accountId != p.getAuthenticatedAsAccountId() || !authDao.hasAccessToProject(projectId,null,false,p.getIdentities()))) { throw new ClientVisibleException(403,"AccessReportRestricted"); }
+            Account account = authDao.getAccountById(accountId);
+            Account project = authDao.getAccountById(projectId);
+            if (account == null || !("user".equals(account.getKind()) || "admin".equals(account.getKind())) || project == null || !"project".equals(project.getKind())) { throw new ClientVisibleException(404,"AccountOrEnvironmentNotFound"); }
+            if (!administrative && (account.getRemoved() != null || project.getRemoved() != null)) { throw new ClientVisibleException(403,"AccessReportRestricted"); }
+            boolean complete = account.getExternalIdType() == null || Arrays.asList("rancher_id","oidc_subject").contains(account.getExternalIdType());
+            boolean active = "active".equals(account.getState());
+            boolean globalAdmin = active && "admin".equals(account.getKind());
+            Set<Identity> identities = Collections.singleton(new Identity("rancher_id",String.valueOf(accountId)));
+            List<Map<String,Object>> sources = new ArrayList<>();
+            if (active) {
+                for (ProjectMember member : authDao.getActiveProjectMembers(projectId)) {
+                    if (!"rancher_id".equals(member.getExternalIdType()) || !String.valueOf(accountId).equals(member.getExternalId())) { continue; }
+                    Map<String,Object> source = new LinkedHashMap<>();
+                    source.put("kind","direct");
+                    source.put("memberId",String.valueOf(member.getId()));
+                    source.put("role",member.getRole());
+                    sources.add(source);
+                }
+                sources.addAll(localGroupStore.grantSources(accountId,projectId));
+            }
+            if (globalAdmin) {
+                Map<String,Object> source = new LinkedHashMap<>();
+                source.put("kind","globalAdmin");
+                source.put("role","owner");
+                sources.add(source);
+            }
+            String role = !active ? null : globalAdmin ? "owner" : complete ? AuthDaoImpl.resolveProjectRole(authDao.getProjectMembersByIdentity(projectId,identities)) : null;
+            return Collections.singletonList(new LocalAccess(String.valueOf(accountId),String.valueOf(projectId),role,complete || globalAdmin,sources));
+        }
+        admin();
+        if ("localGroupAudit".equals(type)) {
+            ApiRequest request = ApiContext.getContext().getApiRequest();
+            String before = parameter(request,"before");
+            String group = parameter(request,"groupId");
+            if (group != null) {
+                String parsed = ApiContext.getContext().getIdFormatter().parseId(group);
+                if (parsed != null) { group=parsed; }
+                if (!group.matches("[a-f0-9-]{36}")) { throw new ClientVisibleException(422,"InvalidGroupId"); }
+            }
+            Long cursor = before == null ? null : parseId(before);
+            if (cursor != null && cursor < 1) { throw new ClientVisibleException(422,"InvalidCursor"); }
+            return localGroupStore.audit(cursor,group);
+        }
+        return localGroupStore.list();
+    }
+    protected Object createInternal(String type,ApiRequest request) {
+        Policy p=admin();
+        if (!"localGroup".equals(type)) { throw new ClientVisibleException(405,"ReadOnlyResource"); }
+        Map<String,Object> body=CollectionUtils.toMap(request.getRequestObject());
+        String id=(String)body.get("id");
+        if (id!=null) {
+            String parsed=ApiContext.getContext().getIdFormatter().parseId(id);
+            if (parsed!=null) { id=parsed; }
+        }
+        String name=(String)body.get("name");
+        if (name==null || name.trim().isEmpty() || name.length()>128) { throw new ClientVisibleException(422,"InvalidGroupName"); }
+        if (id!=null && !id.matches("[a-f0-9-]{36}")) { throw new ClientVisibleException(422,"InvalidGroupId"); }
+        List<Long> users=new ArrayList<>();
+        for (Object value : body.get("members") instanceof List ? (List<?>)body.get("members") : Collections.emptyList()) {
+            long user=parseId(value);
+            Account a=authDao.getAccountById(user);
+            if (a==null || !("user".equals(a.getKind()) || "admin".equals(a.getKind())) || !"active".equals(a.getState()) || a.getRemoved()!=null) { throw new ClientVisibleException(422,"InvalidGroupMember"); }
+            if (!users.contains(user)) { users.add(user); }
+        }
+        Map<Long,String> grants=new HashMap<>();
+        for (Map.Entry<Object,Object> entry : CollectionUtils.toMap(body.get("grants")).entrySet()) {
+            long project=parseId(entry.getKey());
+            Account a=authDao.getAccountById(project);
+            String role=String.valueOf(entry.getValue());
+            if (a==null || !"project".equals(a.getKind()) || a.getRemoved()!=null || !Arrays.asList("owner","member","readonly","restricted").contains(role)) { throw new ClientVisibleException(422,"InvalidGroupGrant"); }
+            grants.put(project,role);
+        }
+        long revision=body.get("revision") instanceof Number ? ((Number)body.get("revision")).longValue() : 0;
+        return localGroupStore.save(id,name.trim(),revision,users,grants,p.getAccountId(),Boolean.TRUE.equals(body.get("delete")));
+    }
+    private String parameter(ApiRequest request,String name) {
+        Object value=request.getRequestParams().get(name);
+        if (value instanceof String[]) {
+            String[] values=(String[])value;
+            return values.length == 0 ? null : values[0];
+        }
+        return value == null ? null : String.valueOf(value);
+    }
+    private long parseId(Object value) {
+        try {
+            String text=String.valueOf(value);
+            String parsed=ApiContext.getContext().getIdFormatter().parseId(text);
+            return Long.parseLong(parsed==null?text:parsed);
+        } catch (RuntimeException e) { throw new ClientVisibleException(422,"InvalidId"); }
+    }
+}
diff --git a/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/LocalGroupStore.java b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/LocalGroupStore.java
