+        } finally {
+            try { c.setAutoCommit(true); } catch (SQLException ignored) { }
+            getConfiguration().connectionProvider().release(c);
+        }
+        if (delete) { return new LocalGroup(); }
+        for (LocalGroup group : list()) { if (group.getId().equals(id)) { return group; } }
+        throw new IllegalStateException("Saved group missing");
+    }
+
+    private int execute(Connection c,String sql,Object... args) throws SQLException {
+        try (PreparedStatement s = c.prepareStatement(sql)) {
+            for (int i=0;i<args.length;i++) { s.setObject(i+1,args[i]); }
+            return s.executeUpdate();
+        }
+    }
+
+    private Map<String,Object> snapshot(Connection connection,String id,boolean lock) throws SQLException {
+        Map<String,Object> result = new LinkedHashMap<>();
+        try (PreparedStatement statement = connection.prepareStatement("SELECT name,revision FROM local_rbac_group WHERE id=?" + (lock ? " FOR UPDATE" : ""))) {
+            statement.setString(1,id);
+            try (ResultSet row = statement.executeQuery()) {
+                if (!row.next()) { return null; }
+                result.put("id",id);
+                result.put("name",row.getString("name"));
+                result.put("revision",row.getLong("revision"));
+            }
+        }
+        List<String> members = new ArrayList<>();
+        try (PreparedStatement statement = connection.prepareStatement("SELECT account_id FROM local_rbac_member WHERE group_id=? ORDER BY account_id")) {
+            statement.setString(1,id);
+            try (ResultSet rows = statement.executeQuery()) {
+                while (rows.next()) { members.add(rows.getString(1)); }
+            }
+        }
+        Map<String,String> grants = new TreeMap<>();
+        try (PreparedStatement statement = connection.prepareStatement("SELECT project_id,role FROM local_rbac_grant WHERE group_id=? ORDER BY project_id")) {
+            statement.setString(1,id);
+            try (ResultSet rows = statement.executeQuery()) {
+                while (rows.next()) { grants.put(rows.getString(1),rows.getString(2)); }
+            }
+        }
+        result.put("members",members);
+        result.put("grants",grants);
+        return result;
+    }
+
+    public List<Map<String,Object>> grantSources(long account,long project) {
+        List<Map<String,Object>> result = new ArrayList<>();
+        if (!CustomizationConfig.CURRENT.enabled("LOCAL_RBAC_ENABLED")) { return result; }
+        for (org.jooq.Record row : create().fetch("SELECT r.id,r.name,g.role FROM local_rbac_group r JOIN local_rbac_member m ON m.group_id=r.id JOIN local_rbac_grant g ON g.group_id=r.id JOIN account a ON a.id=m.account_id WHERE a.removed IS NULL AND a.state='active' AND m.account_id=? AND g.project_id=? ORDER BY r.name,r.id",account,project)) {
+            Map<String,Object> source = new LinkedHashMap<>();
+            source.put("kind","group");
+            source.put("groupId",row.getValue("id"));
+            source.put("name",row.getValue("name"));
+            source.put("role",row.getValue("role"));
+            result.add(source);
+        }
+        return result;
+    }
+
+    public List<LocalGroupAudit> audit(Long before,String groupId) {
+        List<LocalGroupAudit> result = new ArrayList<>();
+        ObjectMapper mapper = new ObjectMapper();
+        for (org.jooq.Record row : create().fetch("SELECT * FROM local_rbac_audit_detail WHERE id<?" + (groupId == null ? "" : " AND group_id=?") + " ORDER BY id DESC LIMIT 100",groupId == null ? new Object[]{before == null ? Long.MAX_VALUE : before} : new Object[]{before == null ? Long.MAX_VALUE : before,groupId})) {
+            try {
+                String previous = (String)row.getValue("before_snapshot");
+                String next = (String)row.getValue("after_snapshot");
+                result.add(new LocalGroupAudit(String.valueOf(row.getValue("id")),String.valueOf(row.getValue("actor")),(String)row.getValue("group_id"),(String)row.getValue("operation"),((java.sql.Timestamp)row.getValue("created")).toInstant().toString(),previous == null ? null : mapper.readValue(previous,Map.class),next == null ? null : mapper.readValue(next,Map.class)));
+            } catch (java.io.IOException error) { throw new IllegalStateException("Invalid stored group audit",error); }
+        }
+        return result;
+    }
+
+    public Long oidcAccount(String hash) {
+        org.jooq.Record r = create().fetchOne("SELECT account_id FROM local_rbac_oidc_user WHERE identity_hash=?",hash);
+        return r == null ? null : ((Number)r.getValue("account_id")).longValue();
+    }
+
+    public void linkOidc(String hash, long account) {
+        create().execute("INSERT INTO local_rbac_oidc_user(identity_hash,account_id) VALUES(?,?)",hash,account);
+    }
+}
