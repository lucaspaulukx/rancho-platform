+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import io.cattle.platform.api.auth.Policy;
+import io.cattle.platform.api.pubsub.subscribe.MessageWriter;
+import io.cattle.platform.api.pubsub.subscribe.jetty.JettyWebSocketSubcriptionHandler;
+import io.cattle.platform.api.utils.ApiUtils;
+import io.cattle.platform.core.dao.AccountDao;
+import io.cattle.platform.core.model.Account;
+import io.cattle.platform.core.model.AuthToken;
+import io.cattle.platform.iaas.api.auth.SecurityConstants;
+import io.cattle.platform.iaas.api.auth.dao.AuthDao;
+import io.cattle.platform.iaas.api.auth.dao.AuthTokenDao;
+import io.cattle.platform.iaas.api.auth.dao.impl.AuthDaoImpl;
+import io.cattle.platform.iaas.api.auth.integration.local.LocalAuthConstants;
+import io.cattle.platform.token.TokenService;
+import io.github.ibuildthecloud.gdapi.request.ApiRequest;
+import java.io.IOException;
+import javax.inject.Inject;
+import javax.servlet.http.Cookie;
+
+/** Protects opaque UI sessions on subscribe. Agent/API-key transports remain separate gates. */
+public class GuardedWebSocketSubscriptionHandler extends JettyWebSocketSubcriptionHandler {
+    @Inject AuthTokenDao authTokenDao;
+    @Inject AuthDao authDao;
+    @Inject AccountDao accountDao;
+    @Inject TokenService tokenService;
+
+    private String role(long projectId, Policy policy) {
+        return AuthDaoImpl.resolveProjectRole(authDao.getProjectMembersByIdentity(projectId, policy.getIdentities()));
+    }
+
+    @Override
+    protected MessageWriter getMessageWriter(ApiRequest request) throws IOException {
+        if (!CustomizationConfig.CURRENT.enabled("SUBSCRIPTION_SESSION_GUARD_ENABLED")) {
+            return super.getMessageWriter(request);
+        }
+        Object attribute = request.getAttribute(LocalAuthConstants.JWT);
+        String value = attribute instanceof String ? (String)attribute : null;
+        if (value == null && request.getServletContext().getRequest().getCookies() != null) {
+            for (Cookie cookie : request.getServletContext().getRequest().getCookies()) {
+                if ("token".equals(cookie.getName())) { value = cookie.getValue(); break; }
+            }
+        }
+        if (value == null || value.trim().isEmpty()) { return super.getMessageWriter(request); }
+        if (value.regionMatches(true, 0, "Bearer ", 0, 7)) { value = value.substring(7).trim(); }
+        final String key = value;
+        final Policy policy = ApiUtils.getPolicy();
+        final long userId = policy.getAuthenticatedAsAccountId();
+        final long targetId = policy.getAccountId();
+        Account initial = authDao.getAccountById(userId);
+        Account target = authDao.getAccountById(targetId);
+        final String kind = initial == null ? null : initial.getKind();
+        final boolean project = target != null && "project".equals(target.getKind());
+        final String initialRole = project && !"admin".equals(kind) ? role(targetId, policy) : null;
+        MessageWriter delegate = super.getMessageWriter(request);
+        if (delegate == null) { return null; }
+        return new SessionGuardedWriter(delegate, new SessionGuardedWriter.Check() {
+            @Override
+            public boolean allowed() {
+                try {
+                    AuthToken token = authTokenDao.getTokenByKey(key);
+                    if (token == null || !SecurityConstants.AUTH_PROVIDER.get().equals(token.getProvider()) ||
+                        token.getAuthenticatedAsAccountId() == null || token.getAuthenticatedAsAccountId().longValue() != userId ||
+                        tokenService.getJsonPayload(token.getValue(), true) == null) { return false; }
+                    Account user = authDao.getAccountById(userId);
+                    if (user == null || !accountDao.isActiveAccount(user) || kind == null || !kind.equals(user.getKind())) { return false; }
+                    if (!project) { return true; }
+                    Account currentTarget = authDao.getAccountById(targetId);
+                    if (currentTarget == null || !accountDao.isActiveAccount(currentTarget)) { return false; }
+                    if ("admin".equals(kind)) { return true; }
+                    String currentRole = role(targetId, policy);
+                    return initialRole != null && initialRole.equals(currentRole) &&
+                        ("owner".equals(currentRole) || "member".equals(currentRole) || "readonly".equals(currentRole) || "restricted".equals(currentRole));
+                } catch (Exception unavailable) { return false; }
+            }
+        });
+    }
+}
