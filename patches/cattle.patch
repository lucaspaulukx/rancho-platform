+++ b/code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/LocalGroupStore.java
@@ -0,0 +1,180 @@
+package io.cattle.platform.iaas.api.auth.localrbac;
+
+import io.cattle.platform.api.auth.Identity;
+import io.cattle.platform.core.model.ProjectMember;
+import io.cattle.platform.core.model.tables.records.ProjectMemberRecord;
+import io.cattle.platform.db.jooq.dao.impl.AbstractJooqDao;
+import io.github.ibuildthecloud.gdapi.exception.ClientVisibleException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.sql.*;
+import java.util.*;
+import javax.annotation.PostConstruct;
+
+/** Local groups are evaluated from the database, never from cached token claims. */
+public class LocalGroupStore extends AbstractJooqDao {
+    @PostConstruct
+    public void init() {
+        create().execute("CREATE TABLE IF NOT EXISTS local_rbac_group (id VARCHAR(36) PRIMARY KEY, name VARCHAR(128) NOT NULL UNIQUE, revision BIGINT NOT NULL DEFAULT 1) ENGINE=InnoDB");
+        create().execute("CREATE TABLE IF NOT EXISTS local_rbac_member (group_id VARCHAR(36) NOT NULL, account_id BIGINT NOT NULL, PRIMARY KEY(group_id,account_id), KEY(account_id)) ENGINE=InnoDB");
+        create().execute("CREATE TABLE IF NOT EXISTS local_rbac_grant (group_id VARCHAR(36) NOT NULL, project_id BIGINT NOT NULL, role VARCHAR(16) NOT NULL, PRIMARY KEY(group_id,project_id)) ENGINE=InnoDB");
+        create().execute("CREATE TABLE IF NOT EXISTS local_rbac_audit (id BIGINT AUTO_INCREMENT PRIMARY KEY, actor BIGINT NOT NULL, group_id VARCHAR(36) NOT NULL, operation VARCHAR(16) NOT NULL, created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP) ENGINE=InnoDB");
+        create().execute("CREATE TABLE IF NOT EXISTS local_rbac_audit_detail (id BIGINT AUTO_INCREMENT PRIMARY KEY, actor BIGINT NOT NULL, group_id VARCHAR(36) NOT NULL, operation VARCHAR(16) NOT NULL, before_snapshot MEDIUMTEXT NULL, after_snapshot MEDIUMTEXT NULL, created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, KEY(group_id,id)) ENGINE=InnoDB");
+        create().execute("CREATE TABLE IF NOT EXISTS local_rbac_oidc_user (identity_hash VARCHAR(64) PRIMARY KEY, account_id BIGINT NOT NULL UNIQUE) ENGINE=InnoDB");
+    }
+
+    public List<ProjectMember> grants(Set<Identity> identities, Long projectId) {
+        if (!CustomizationConfig.CURRENT.enabled("LOCAL_RBAC_ENABLED")) { return Collections.emptyList(); }
+        Set<Long> accounts = new HashSet<>();
+        for (Identity identity : identities) {
+            // rancher_id identities in policies are internal numeric IDs.
+            if ("rancher_id".equals(identity.getExternalIdType())) {
+                try { accounts.add(Long.valueOf(identity.getExternalId())); } catch (NumberFormatException ignored) { }
+            }
+        }
+        List<ProjectMember> result = new ArrayList<>();
+        for (Long account : accounts) {
+            for (org.jooq.Record row : create().fetch("SELECT g.project_id,g.role FROM local_rbac_grant g JOIN local_rbac_member m ON m.group_id=g.group_id JOIN local_rbac_group r ON r.id=g.group_id JOIN account a ON a.id=m.account_id WHERE a.removed IS NULL AND a.state='active' AND m.account_id=?" + (projectId == null ? "" : " AND g.project_id=?"), projectId == null ? new Object[]{account} : new Object[]{account,projectId})) {
+                ProjectMemberRecord member = new ProjectMemberRecord();
+                member.setProjectId(((Number)row.getValue("project_id")).longValue());
+                member.setRole((String)row.getValue("role"));
+                result.add(member);
+            }
+        }
+        return result;
+    }
+
+    public List<LocalGroup> list() {
+        List<LocalGroup> groups = new ArrayList<>();
+        for (org.jooq.Record row : create().fetch("SELECT * FROM local_rbac_group ORDER BY name")) {
+            LocalGroup group = new LocalGroup();
+            group.setId((String)row.getValue("id"));
+            group.setName((String)row.getValue("name"));
+            group.setRevision(((Number)row.getValue("revision")).longValue());
+            List<String> users = new ArrayList<>();
+            for (org.jooq.Record member : create().fetch("SELECT account_id FROM local_rbac_member WHERE group_id=? ORDER BY account_id",group.getId())) {
+                users.add(String.valueOf(member.getValue("account_id")));
+            }
+            group.setMembers(users);
+            Map<String,String> grants = new TreeMap<>();
+            for (org.jooq.Record grant : create().fetch("SELECT project_id,role FROM local_rbac_grant WHERE group_id=?",group.getId())) {
+                grants.put(String.valueOf(grant.getValue("project_id")),(String)grant.getValue("role"));
+            }
+            group.setGrants(grants);
+            groups.add(group);
+        }
+        return groups;
+    }
+
+    public LocalGroup save(String id, String name, long revision, List<Long> users, Map<Long,String> grants, long actor, boolean delete) {
+        boolean fresh = id == null;
+        if (fresh) { id = UUID.randomUUID().toString(); }
+        Connection c = getConfiguration().connectionProvider().acquire();
+        try {
+            c.setAutoCommit(false);
+            Map<String,Object> before = snapshot(c,id,true);
+            if (fresh) {
+                execute(c,"INSERT INTO local_rbac_group(id,name) VALUES(?,?)",id,name);
+            } else {
+                int changed = execute(c,"UPDATE local_rbac_group SET name=?,revision=revision+1 WHERE id=? AND revision=?",name,id,revision);
+                if (changed != 1) { throw new ClientVisibleException(409,"GroupChanged","Recarregue o grupo antes de salvar.",null); }
+            }
+            execute(c,"DELETE FROM local_rbac_member WHERE group_id=?",id);
+            execute(c,"DELETE FROM local_rbac_grant WHERE group_id=?",id);
+            if (delete) {
+                execute(c,"DELETE FROM local_rbac_group WHERE id=?",id);
+            } else {
+                for (Long user : users) { execute(c,"INSERT INTO local_rbac_member(group_id,account_id) VALUES(?,?)",id,user); }
+                for (Map.Entry<Long,String> grant : grants.entrySet()) { execute(c,"INSERT INTO local_rbac_grant(group_id,project_id,role) VALUES(?,?,?)",id,grant.getKey(),grant.getValue()); }
+            }
+            execute(c,"INSERT INTO local_rbac_audit(actor,group_id,operation) VALUES(?,?,?)",actor,id,delete ? "delete" : fresh ? "create" : "update");
+            ObjectMapper mapper = new ObjectMapper();
+            Map<String,Object> after = snapshot(c,id,false);
+            execute(c,"INSERT INTO local_rbac_audit_detail(actor,group_id,operation,before_snapshot,after_snapshot) VALUES(?,?,?,?,?)",actor,id,delete ? "delete" : fresh ? "create" : "update",before == null ? null : mapper.writeValueAsString(before),after == null ? null : mapper.writeValueAsString(after));
+            c.commit();
+        } catch (Exception e) {
+            try { c.rollback(); } catch (SQLException ignored) { }
+            if (e instanceof ClientVisibleException) { throw (ClientVisibleException)e; }
+            if (e instanceof SQLException && "23000".equals(((SQLException)e).getSQLState())) { throw new ClientVisibleException(409,"DuplicateGroup"); }
