+	var calls int32
+	var denied int32
+	g := streamTestGuard(t, func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&calls, 1)
+		if r.Method != "POST" || r.URL.Path != "/host-stream-session/check" || r.Header.Get("X-Rancher-Stream-Guard") != strings.Repeat("s", 43) {
+			t.Error("untrusted callback")
+		}
+		var body map[string]interface{}
+		if json.NewDecoder(r.Body).Decode(&body) != nil || body["path"] != "/v1/echo" {
+			t.Error("invalid callback")
+		}
+		json.NewEncoder(w).Encode(map[string]bool{"allowed": atomic.LoadInt32(&denied) == 0})
+	})
+	token := streamTestToken(t, streamTestClaims())
+	var workers sync.WaitGroup
+	for i := 0; i < 40; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			p, err := g.proof(token, "/v1/echo")
+			if err != nil || !g.allowed(p) {
+				t.Error("valid reference denied")
+			}
+		}()
+	}
+	workers.Wait()
+	if atomic.LoadInt32(&calls) != 1 {
+		t.Fatal("parallel requests not coalesced")
+	}
+	atomic.StoreInt32(&denied, 1)
+	time.Sleep(300 * time.Millisecond)
+	p, _ := g.proof(streamTestToken(t, streamTestClaims()), "/v1/echo")
+	if g.allowed(p) {
+		t.Fatal("revoked reference accepted")
+	}
+}
+func TestHostStreamCallbackFailures(t *testing.T) {
+	for _, name := range []string{"denied", "redirect", "bad-json", "oversize", "timeout"} {
+		t.Run(name, func(t *testing.T) {
+			g := streamTestGuard(t, func(w http.ResponseWriter, r *http.Request) {
+				switch name {
+				case "denied":
+					w.WriteHeader(403)
+				case "redirect":
+					http.Redirect(w, r, "/other", 302)
+				case "bad-json":
+					w.Write([]byte("broken"))
+				case "oversize":
+					w.Write([]byte(strings.Repeat(" ", 70001) + `{"allowed":true}`))
+				case "timeout":
+					time.Sleep(900 * time.Millisecond)
+					w.Write([]byte(`{"allowed":true}`))
+				}
+			})
+			p, _ := g.proof(streamTestToken(t, streamTestClaims()), "/v1/echo")
+			start := time.Now()
+			if g.allowed(p) {
+				t.Fatal("failure allowed access")
+			}
+			if time.Since(start) > 850*time.Millisecond {
+				t.Fatal("verification budget exceeded")
+			}
+		})
+	}
+}
+func TestHostStreamRenewal(t *testing.T) {
+	for _, mismatch := range []bool{false, true} {
+		t.Run(map[bool]string{false: "valid", true: "changed-scope"}[mismatch], func(t *testing.T) {
+			next := streamTestClaims()
+			if mismatch {
+				next["rancherStream"].(map[string]interface{})["userId"] = "99"
+			}
+			renewed := streamTestToken(t, next).Raw
+			g := streamTestGuard(t, func(w http.ResponseWriter, r *http.Request) {
+				var body map[string]interface{}
+				json.NewDecoder(r.Body).Decode(&body)
+				if body["renew"] != true {
+					t.Error("renewal not requested")
+				}
+				json.NewEncoder(w).Encode(map[string]interface{}{"allowed": true, "renewed": renewed})
+			})
+			claims := streamTestClaims()
+			claims["exp"] = time.Now().Unix() + 2
+			claims["iat"] = time.Now().Unix() - 30
+			p, _ := g.proof(streamTestToken(t, claims), "/v1/echo")
+			if g.allowed(p) == mismatch {
+				t.Fatal("incorrect renewal decision")
+			}
+			p.expires = time.Now().Unix() - 1
+			if g.allowed(p) {
+				t.Fatal("expired proof renewed")
+			}
+		})
+	}
+}
+func TestHostStreamIdleWatchAndLegacy(t *testing.T) {
+	g := streamTestGuard(t, func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(`{"allowed":false}`)) })
+	p, _ := g.proof(streamTestToken(t, streamTestClaims()), "/v1/echo")
+	closed := make(chan struct{})
+	stop := g.watch([]*hostStreamProof{p}, func() { close(closed) })
+	defer stop()
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("idle revocation not observed")
+	}
+	stop()
+	var off *hostStreamGuard
+	if proof, err := off.proof(nil, ""); err != nil || !off.allowed(proof) {
+		t.Fatal("disabled guard changed legacy behavior")
+	}
+	if g.allowed(nil) {
+		t.Fatal("nil reference allowed")
+	}
+}
+func TestHostStreamConfiguration(t *testing.T) {
+	for _, address := range []string{"example.com:8081", "127.0.0.1", "127.0.0.1:8081?x=1", "user@127.0.0.1:8081", "172.21.0.4:8081"} {
+		if _, err := newHostStreamGuard(true, address, strings.Repeat("s", 43), nil); err == nil {
+			t.Fatal("unsafe callback address")
+		}
+	}
+	if _, err := newHostStreamGuard(true, "127.0.0.1:8081", "short", nil); err == nil {
+		t.Fatal("missing key accepted")
+	}
+	if g, err := newHostStreamGuard(false, "invalid", "", nil); err != nil || g != nil {
+		t.Fatal("off configuration failed")
+	}
+}
