diff --git a/proxy/host_stream_guard.go b/proxy/host_stream_guard.go
new file mode 100644
--- /dev/null
+++ b/proxy/host_stream_guard.go
@@ -0,0 +1,353 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	jwt "github.com/dgrijalva/jwt-go"
+	"github.com/gorilla/websocket"
+)
+
+const streamCheckBudget = 750 * time.Millisecond
+
+type hostStreamProof struct {
+	mu                          sync.Mutex
+	raw, path, mode, key        string
+	expires, uiExpires, renewAt int64
+}
+
+type streamDecision struct {
+	done    chan struct{}
+	checked time.Time
+	allowed bool
+}
+
+// One shared, bounded cache for a proxy process. Keys never contain credentials.
+type hostStreamGuard struct {
+	endpoint  string
+	client    *http.Client
+	mu        sync.Mutex
+	decisions map[string]*streamDecision
+	slots     chan struct{}
+	ttl       time.Duration
+	secret    string
+	publicKey interface{}
+}
+
+func newHostStreamGuard(enabled bool, address, secret string, publicKey interface{}) (*hostStreamGuard, error) {
+	if !enabled {
+		return nil, nil
+	}
+	if len(secret) < 32 || len(secret) > 256 {
+		return nil, errors.New("Host stream verification key missing")
+	}
+	endpoint, err := url.Parse("http://" + address + "/host-stream-session/check")
+	if err != nil || endpoint.User != nil || endpoint.RawQuery != "" || endpoint.Fragment != "" || endpoint.Port() == "" {
+		return nil, errors.New("Invalid host stream verification address")
+	}
+	host := endpoint.Hostname()
+	ip := net.ParseIP(host)
+	if host != "localhost" && (ip == nil || !ip.IsLoopback()) {
+		return nil, errors.New("Host stream verification requires a loopback Cattle address")
+	}
+	return &hostStreamGuard{endpoint: endpoint.String(), secret: secret, publicKey: publicKey,
+		client: &http.Client{Timeout: streamCheckBudget,
+			CheckRedirect: func(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse },
+			Transport: &http.Transport{Proxy: nil, MaxIdleConns: 8, MaxIdleConnsPerHost: 8,
+				IdleConnTimeout: 30 * time.Second,
+				DialContext:     (&net.Dialer{Timeout: 250 * time.Millisecond, KeepAlive: 30 * time.Second}).DialContext}},
+		decisions: make(map[string]*streamDecision), slots: make(chan struct{}, 8), ttl: 250 * time.Millisecond}, nil
+}
+
+func streamSeconds(value interface{}) (int64, bool) {
+	switch number := value.(type) {
+	case float64:
+		if math.IsNaN(number) || math.IsInf(number, 0) || number != math.Trunc(number) || number <= 0 || number > 1e12 {
+			return 0, false
+		}
+		return int64(number), true
+	case int64:
+		return number, number > 0
+	case int:
+		return int64(number), number > 0
+	}
+	return 0, false
+}
+
+func streamID(value interface{}) (string, bool) {
+	text, ok := value.(string)
+	if !ok || len(text) == 0 || len(text) > 19 || text[0] == '0' {
+		return "", false
+	}
+	for _, char := range text {
+		if char < '0' || char > '9' {
+			return "", false
+		}
+	}
+	number, err := strconv.ParseInt(text, 10, 64)
+	return text, err == nil && number > 0
+}
+
+func streamEnvelope(token *jwt.Token) (int64, bool) {
+	if token == nil || !token.Valid || token.Method == nil || token.Method.Alg() != "RS256" || len(token.Raw) == 0 || len(token.Raw) > 16*1024*1024 {
+		return 0, false
+	}
+	expires, ok := streamSeconds(token.Claims["exp"])
+	return expires, ok && expires > time.Now().Unix()
+}
+
+func (g *hostStreamGuard) proof(token *jwt.Token, path string) (*hostStreamProof, error) {
+	if g == nil {
+		return nil, nil
+	}
+	expires, valid := streamEnvelope(token)
+	if !valid {
+		return nil, errors.New("Invalid stream envelope")
+	}
+	binding, ok := token.Claims["rancherStream"].(map[string]interface{})
+	if !ok {
+		return nil, errors.New("Stream session reference required")
+	}
+	version, valid := streamSeconds(binding["v"])
+	signedPath, pathOK := binding["path"].(string)
+	if !valid || version != 1 || !pathOK || path != signedPath || len(path) == 0 || len(path) > 4096 {
+		return nil, errors.New("Invalid stream scope")
+	}
+	host, hostOK := streamID(binding["hostId"])
+	project, projectOK := streamID(binding["projectId"])
+	mode, _ := binding["mode"].(string)
+	if !hostOK || !projectOK || (mode != "ui" && mode != "technical") {
+		return nil, errors.New("Invalid stream mode or target")
+	}
+	result := &hostStreamProof{raw: token.Raw, path: path, mode: mode, expires: expires}
+	if mode == "technical" {
+		return result, nil
+	}
+	session, sessionOK := streamID(binding["tokenId"])
+	user, userOK := streamID(binding["userId"])
+	kind, _ := binding["userKind"].(string)
+	role, _ := binding["role"].(string)
+	fingerprint, _ := binding["sessionHash"].(string)
+	hashBytes, hashErr := hex.DecodeString(fingerprint)
+	uiExpires, expiryOK := streamSeconds(binding["uiExp"])
+	if !sessionOK || !userOK || !expiryOK || hashErr != nil || len(hashBytes) != 32 || len(fingerprint) != 64 ||
+		fingerprint != strings.ToLower(fingerprint) || uiExpires <= time.Now().Unix() ||
+		(kind != "user" && kind != "admin") || (role != "owner" && role != "member" && role != "restricted" && role != "readonly") {
+		return nil, errors.New("Invalid UI session reference")
+	}
+	result.uiExpires = uiExpires
+	margin := int64(30)
+	if issued, valid := streamSeconds(token.Claims["iat"]); valid && issued < expires {
+		margin = (expires - issued) / 10
+		if margin < 1 {
+			margin = 1
+		}
+		if margin > 30 {
+			margin = 30
+		}
+	}
+	result.renewAt = expires - margin
+	sum := sha256.Sum256([]byte(strings.Join([]string{session, fingerprint, user, kind, project, role, host, strconv.FormatInt(uiExpires, 10)}, "/")))
+	result.key = hex.EncodeToString(sum[:])
+	if raw, present := token.Claims["rancherStreamProof"]; present {
+		compact, ok := raw.(string)
+		if !ok || len(compact) == 0 || len(compact) > 65536 {
+			return nil, errors.New("Invalid compact proof")
+		}
+		inner, err := jwt.Parse(compact, func(_ *jwt.Token) (interface{}, error) { return g.publicKey, nil })
+		if err != nil || inner == nil {
+			return nil, errors.New("Invalid compact signature")
+		}
+		if _, nested := inner.Claims["rancherStreamProof"]; nested {
+			return nil, errors.New("Nested compact proof")
+		}
+		next, err := g.proof(inner, path)
+		if err != nil || next.mode != "ui" || next.key != result.key {
+			return nil, errors.New("Compact scope mismatch")
+		}
+		return next, nil
+	}
+	if len(result.raw) > 65536 {
+		return nil, errors.New("Compact proof required")
+	}
+	return result, nil
+}
+
+func (g *hostStreamGuard) expiryProof(token *jwt.Token) (*hostStreamProof, error) {
+	if g == nil {
+		return nil, nil
+	}
+	expires, valid := streamEnvelope(token)
+	if !valid {
+		return nil, errors.New("Invalid metrics envelope")
+	}
+	return &hostStreamProof{mode: "envelope", expires: expires}, nil
+}
+
+func (g *hostStreamGuard) allowed(proof *hostStreamProof) bool {
+	if g == nil {
+		return true
+	}
+	if proof == nil {
+		return false
+	}
+	proof.mu.Lock()
+	defer proof.mu.Unlock()
+	if proof.mode == "technical" {
+		return true
+	} // Legacy technical stream lifetime is a separate gate.
+	if proof.expires <= time.Now().Unix() {
+		return false
+	}
+	if proof.mode == "envelope" {
+		return true
+	}
+	if proof.mode != "ui" || proof.uiExpires <= time.Now().Unix() {
+		return false
+	}
+	// A trusted proxy renews only a still-valid proof for an existing socket.
+	// No expired JWT is accepted, and the browser never receives this renewal.
+	if time.Now().Unix() >= proof.renewAt && proof.expires < proof.uiExpires {
+		valid, renewed := g.verify(proof, true)
+		if !valid || len(renewed) == 0 || len(renewed) > 65536 {
+			return false
+		}
+		token, err := jwt.Parse(renewed, func(_ *jwt.Token) (interface{}, error) { return g.publicKey, nil })
+		if err != nil {
+			return false
+		}
+		next, err := g.proof(token, proof.path)
+		if err != nil || next.key != proof.key || next.expires <= proof.expires {
+			return false
+		}
+		proof.raw, proof.expires, proof.renewAt = next.raw, next.expires, next.renewAt
+		return true
+	}
+	now := time.Now()
+	g.mu.Lock()
+	if entry, found := g.decisions[proof.key]; found {
+		if entry.checked.IsZero() {
+			done := entry.done
+			g.mu.Unlock()
+			timer := time.NewTimer(streamCheckBudget)
+			defer timer.Stop()
+			select {
+			case <-done:
+				return entry.allowed
+			case <-timer.C:
+				return false
+			}
+		}
+		if now.Sub(entry.checked) < g.ttl {
+			valid := entry.allowed
+			g.mu.Unlock()
+			return valid
+		}
+		delete(g.decisions, proof.key)
+	}
+	if len(g.decisions) >= 4096 {
+		for key, entry := range g.decisions {
+			if !entry.checked.IsZero() && now.Sub(entry.checked) >= g.ttl {
+				delete(g.decisions, key)
+			}
+		}
+		if len(g.decisions) >= 4096 {
+			g.mu.Unlock()
+			return false
+		}
+	}
+	entry := &streamDecision{done: make(chan struct{})}
+	g.decisions[proof.key] = entry
+	g.mu.Unlock()
+	valid, _ := g.verify(proof, false)
+	g.mu.Lock()
+	entry.allowed = valid
+	entry.checked = time.Now()
+	close(entry.done)
+	g.mu.Unlock()
+	return valid
+}
+
+func (g *hostStreamGuard) verify(proof *hostStreamProof, renew bool) (bool, string) {
+	ctx, cancel := context.WithTimeout(context.Background(), streamCheckBudget)
+	defer cancel()
+	select {
+	case g.slots <- struct{}{}:
+		defer func() { <-g.slots }()
+	case <-ctx.Done():
+		return false, ""
+	}
+	body, err := json.Marshal(map[string]interface{}{"token": proof.raw, "path": proof.path, "renew": renew})
+	if err != nil {
+		return false, ""
+	}
+	request, err := http.NewRequestWithContext(ctx, "POST", g.endpoint, bytes.NewReader(body))
+	if err != nil {
+		return false, ""
+	}
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("X-Rancher-Stream-Guard", g.secret)
+	response, err := g.client.Do(request)
+	if err != nil {
+		return false, ""
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return false, ""
+	}
+	payload, err := io.ReadAll(io.LimitReader(response.Body, 70001))
+	if err != nil || len(payload) > 70000 {
+		return false, ""
+	}
+	var result struct {
+		Allowed bool   `json:"allowed"`
+		Renewed string `json:"renewed"`
+	}
+	return json.Unmarshal(payload, &result) == nil && result.Allowed, result.Renewed
+}
+
+func closeHostStream(ws *websocket.Conn) {
+	ws.WriteControl(websocket.CloseMessage, websocket.FormatCloseMessage(websocket.ClosePolicyViolation, "Access no longer available"), time.Now().Add(time.Second))
+	ws.Close()
+}
+
+// Idle sockets must close too; stopping the watcher is idempotent and never blocks cleanup.
+func (g *hostStreamGuard) watch(proofs []*hostStreamProof, denied func()) func() {
+	if g == nil {
+		return func() {}
+	}
+	done := make(chan struct{})
+	var once sync.Once
+	go func() {
+		ticker := time.NewTicker(time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-done:
+				return
+			case <-ticker.C:
+				for _, proof := range proofs {
+					if !g.allowed(proof) {
+						denied()
+						return
+					}
+				}
+			}
+		}
+	}()
+	return func() { once.Do(func() { close(done) }) }
+}
