FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
RUN apt-get update && apt-get install -y --no-install-recommends mariadb-client && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/rancho
COPY migration/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY migration/__init__.py migration/tool.py migration/restore_on_start.py migration/
ENTRYPOINT ["python", "-m", "migration.restore_on_start"]
