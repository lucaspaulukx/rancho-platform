{
  "name": "rancher-community-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-bundles.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "config:migrate": "node scripts/migrate-config.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "prebuild": "node scripts/themes.mjs",
    "predev": "node scripts/themes.mjs",
    "format": "prettier --write src public/console-config.json *.ts package*.json tsconfig.json index.html scripts",
    "format:check": "prettier --check src public/console-config.json *.ts package*.json tsconfig.json index.html scripts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "Apache-2.0"
}
