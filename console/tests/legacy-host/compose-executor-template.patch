@@ -0,0 +1,25 @@
+package template
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestApplyParallel(t *testing.T) {
+	var group sync.WaitGroup
+	for worker := 0; worker < 24; worker++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			for i := 0; i < 25; i++ {
+				result, err := Apply([]byte("{{ .Values.name | upper }}"), StackInfo{}, EnvironmentInfo{}, map[string]string{"name": "rancho"})
+				if err != nil || string(result) != "RANCHO" {
+					t.Errorf("unexpected template result %q, error %v", result, err)
+					return
+				}
+			}
+		}()
+	}
+	group.Wait()
+}
+
