FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ENV GO111MODULE=off GOPATH=/go CGO_ENABLED=0
WORKDIR /go/src/github.com/rancher/healthcheck
ADD --checksum=sha256:87a2c50eed5467dfe02671ff3184cbea440c2225395c9b2dcef6ed8528929c52 https://codeload.github.com/rancher/healthcheck/tar.gz/2910775659b6f5f37d27aa52f05085e84d470c61 /tmp/healthcheck.tar.gz
RUN --network=none tar -xzf /tmp/healthcheck.tar.gz --strip-components=1 && \
    go build -trimpath -buildvcs=false -ldflags="-X main.VERSION=v0.3.8" -o /out/healthcheck . && \
    /out/healthcheck -h && \
    mkdir -p /out/licenses && \
    find . -type f \( -iname '*license*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'patents*' \) \
        -exec cp --parents '{}' /out/licenses/ \;

FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl haproxy iputils-ping netcat-openbsd tini && \
    rm -rf /var/lib/apt/lists/* && ln -s /usr/bin/tini /tini
COPY --from=build /out/healthcheck /usr/bin/healthcheck
COPY --from=build /out/licenses/ /usr/share/doc/rancho-healthcheck/
COPY --from=build /go/src/github.com/rancher/healthcheck/pkg/haproxy/haproxy_template.cfg /etc/haproxy/
COPY --from=build /go/src/github.com/rancher/healthcheck/pkg/haproxy/haproxy_reload.sh /usr/bin/
COPY --chmod=0755 modern-metadata-entry.sh /rancher-entrypoint.sh
ENTRYPOINT ["/rancher-entrypoint.sh", "/tini", "--"]
CMD ["healthcheck"]
