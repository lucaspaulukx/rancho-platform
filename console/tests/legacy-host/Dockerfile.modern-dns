FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ENV GO111MODULE=off GOPATH=/go CGO_ENABLED=0
WORKDIR /go/src/github.com/rancher/rancher-dns
ADD --checksum=sha256:36af2321ed9a236de11de12a8e70288068b4ae7651407da8d0dddc360326a014 https://codeload.github.com/rancher/rancher-dns/tar.gz/456e580626fc7bf861b9e2541ab156bf222c5b45 /tmp/dns.tar.gz
RUN --network=none tar -xzf /tmp/dns.tar.gz --strip-components=1 && \
    go test -vet=off ./... && \
    go build -trimpath -buildvcs=false -ldflags="-X main.VERSION=v0.17.4" -o /out/rancher-dns . && \
    /out/rancher-dns --version && \
    mkdir -p /out/licenses && \
    find . -type f \( -iname '*license*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'patents*' \) \
        -exec cp --parents '{}' /out/licenses/ \;

FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/rancher-dns /usr/bin/rancher-dns
COPY --from=build /out/licenses/ /usr/share/doc/rancho-dns/
COPY --chmod=0755 modern-metadata-entry.sh /rancher-entrypoint.sh
ENTRYPOINT ["/rancher-entrypoint.sh"]
CMD ["rancher-dns"]
