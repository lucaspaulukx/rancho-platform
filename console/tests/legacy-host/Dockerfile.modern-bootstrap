ARG CLIENT_IMAGE=rancho-agent-modern-client:local
FROM ${CLIENT_IMAGE} AS client
FROM ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl iproute2 iptables iputils-ping jq kmod openssl procps \
        python3 python3-requests python3-six util-linux && rm -rf /var/lib/apt/lists/*
COPY --from=client /usr/bin/docker /usr/bin/r /usr/bin/share-mnt /usr/bin/
COPY --from=client /usr/share/doc/rancho-share-mnt/ /usr/share/doc/rancho-share-mnt/
COPY --from=client /run.sh /register.py /resolve_url.py /
COPY --from=client /usr/local/lib/python2.7/dist-packages/gdapi.py /usr/local/lib/python2.7/dist-packages/cattle.py /usr/local/lib/python3.12/dist-packages/
COPY --from=client /usr/local/lib/python2.7/dist-packages/gdapi_python-0.5.3.dist-info/ /usr/share/doc/rancho-bootstrap/gdapi/
COPY --from=client /usr/local/lib/python2.7/dist-packages/cattle-0.5.4.dist-info/ /usr/share/doc/rancho-bootstrap/cattle/
COPY port-bootstrap-python.py /tmp/
RUN --network=none python3 /tmp/port-bootstrap-python.py && \
    rm /tmp/port-bootstrap-python.py && \
    python3 -m py_compile /register.py /resolve_url.py && \
    python3 -c 'import cattle, gdapi' && bash -n /run.sh
ENV RANCHER_AGENT_IMAGE=rancher/agent:v1.2.11
LABEL io.rancher.container.system=rancher-agent
ENTRYPOINT ["/run.sh"]
