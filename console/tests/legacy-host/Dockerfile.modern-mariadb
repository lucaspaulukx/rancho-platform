FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
ADD --checksum=sha256:2b70da8a5480fafedc16bb1fc91b572f064d03df736cbd91a616af2f1b66ab51 https://codeload.github.com/tianon/gosu/tar.gz/29b939aa5bd4dc588af765b8248f6e39150d2565 /tmp/gosu.tar.gz
RUN tar -xzf /tmp/gosu.tar.gz --strip-components=1 && go mod download && go mod verify
RUN --network=none go build -mod=readonly -trimpath -buildvcs=false -ldflags="-X main.version=1.20" -o /out/gosu . && \
    /out/gosu nobody id -un | grep -Fx nobody

FROM mariadb:10.11@sha256:7d829180b5b2a9ba74f6242876ab401a0d7dd338a807e522ef92bc9698760f20
COPY --from=build /out/gosu /usr/local/bin/gosu
COPY --from=build /src/LICENSE /usr/share/doc/rancho-gosu/LICENSE
