ARG BACKEND_JAVA17_IMAGE=rancho-backend-java17:local
FROM scratch AS logging-jars
ADD --checksum=sha256:5230217ccba7a9d31dda1dd878e5606037a7972282c7d3f8eac1efa80e9463d9 https://repo.maven.apache.org/maven2/ch/qos/logback/logback-classic/1.6.6/logback-classic-1.6.6.jar /logback-classic-1.6.6.jar
ADD --checksum=sha256:5458415d5d58a97ab670632f9b2bdac2d6f7e0e11455b45dd4e64e90d12670ab https://repo.maven.apache.org/maven2/ch/qos/logback/logback-core/1.6.6/logback-core-1.6.6.jar /logback-core-1.6.6.jar
ADD --checksum=sha256:e91ff6d720609e7a194ffe758c3ed5c84e798617ae07b0a0f6a4fe229741b4bb https://repo.maven.apache.org/maven2/org/slf4j/slf4j-api/2.0.19/slf4j-api-2.0.19.jar /slf4j-api-2.0.19.jar
ADD --checksum=sha256:7d5be917811ee275929a608d51e0f6a9eb8d17b25460ecb160e81e9ee23538c0 https://repo.maven.apache.org/maven2/org/slf4j/log4j-over-slf4j/2.0.19/log4j-over-slf4j-2.0.19.jar /log4j-over-slf4j-2.0.19.jar

FROM ${BACKEND_JAVA17_IMAGE} AS cattle
COPY modern-backend-single-node.patch modern-backend-servlet.patch modern-backend-logback.patch ServletApplicationContext.java configure-modern-servlets.py /tmp/modern-backend/
RUN --network=none --mount=from=logging-jars,target=/tmp/logging-jars set -eu; \
    cd /lab/cattle; \
    git apply --ignore-space-change /tmp/modern-backend/*.patch; \
    cp -aL /usr/share/cattle/war /opt/war; \
    python3 /tmp/modern-backend/configure-modern-servlets.py; \
    lib=/opt/war/WEB-INF/lib; \
    rm "$lib/h2-1.4.187.jar" "$lib/hazelcast-3.8.jar" "$lib/spring-web-5.3.39.jar" \
        "$lib/cattle-hazelcast-eventing-0.5.0-SNAPSHOT.jar" \
        "$lib/cattle-hazelcast-lock-0.5.0-SNAPSHOT.jar" \
        "$lib/logback-classic-1.2.3.jar" "$lib/logback-core-1.2.3.jar" \
        "$lib/slf4j-api-1.7.5.jar" "$lib/log4j-over-slf4j-1.7.5.jar"; \
    install -m 0644 /tmp/logging-jars/*.jar "$lib/"; \
    /usr/lib/jvm/zulu-8-amd64/bin/jar uf "$lib/cattle-framework-logback-0.5.0-SNAPSHOT.jar" \
        -C code/framework/logback/src/main/resources logback; \
    mkdir /tmp/single-node; \
    /usr/lib/jvm/zulu-8-amd64/bin/javac -encoding UTF-8 \
        -cp "/opt/war:$lib/*:/opt/war/WEB-INF/jetty/*" -d /tmp/single-node \
        code/packaging/app-config/src/main/java/io/cattle/platform/app/AppConfig.java \
        code/implementation/hazelcast/common/src/main/java/io/cattle/platform/hazelcast/membership/DBDiscovery.java \
        code/framework/module/src/main/java/io/cattle/platform/spring/web/StartupListener.java \
        code/framework/module/src/main/java/io/cattle/platform/spring/web/SpringFilter.java \
        code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/OidcServlet.java \
        code/iaas/auth-logic/src/main/java/io/cattle/platform/iaas/api/auth/localrbac/HostStreamGuardServlet.java \
        /tmp/modern-backend/ServletApplicationContext.java; \
    /usr/lib/jvm/zulu-8-amd64/bin/jar uf "$lib/cattle-app-config-0.5.0-SNAPSHOT.jar" \
        -C /tmp/single-node io/cattle/platform/app/AppConfig.class; \
    /usr/lib/jvm/zulu-8-amd64/bin/jar uf "$lib/cattle-hazelcast-common-0.5.0-SNAPSHOT.jar" \
        -C /tmp/single-node io/cattle/platform/hazelcast/membership; \
    /usr/lib/jvm/zulu-8-amd64/bin/jar uf "$lib/cattle-framework-spring-module-0.5.0-SNAPSHOT.jar" \
        -C /tmp/single-node io/cattle/platform/spring/web; \
    /usr/lib/jvm/zulu-8-amd64/bin/jar uf "$lib/cattle-iaas-auth-logic-0.5.0-SNAPSHOT.jar" \
        -C /tmp/single-node io/cattle/platform/iaas/api/auth/localrbac

FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git tini zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 && rm -rf /var/lib/apt/lists/*
COPY --from=cattle /opt/rancho-java17 /opt/rancho-java17
COPY --from=cattle /opt/war /opt/cattle
COPY --from=cattle /usr/share/cattle/artifacts /usr/share/cattle/artifacts
COPY --from=cattle /usr/share/cattle/env_vars /usr/share/cattle/env_vars
COPY --from=cattle /usr/bin/rancher-* /usr/bin/docker-machine* /usr/bin/compose /usr/bin/websocket-proxy /usr/bin/
COPY modern-backend-entry.sh /usr/local/bin/rancho-entry
ENV CATTLE_HOME=/var/lib/cattle CATTLE_DB_CATTLE_DATABASE=mysql DEFAULT_CATTLE_API_UI_INDEX=local
ENV RANCHER_HOST_STREAM_PROXY_PROTOCOL=1 RANCHER_METRICS_PAYLOAD_PROXY_PROTOCOL=1 RANCHER_API_KEY_STREAM_PROXY_PROTOCOL=1
WORKDIR /var/lib/cattle
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "/usr/local/bin/rancho-entry"]
