ARG BACKEND_IMAGE=rancho-backend:local
FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS packages
ENV GO111MODULE=off GOPATH=/go CGO_ENABLED=0
ADD --checksum=sha256:230588a9c554b0c834db396f89ac504aafdcc218007982f6e5ac38fe67292963 https://codeload.github.com/rancher/agent/tar.gz/c8663d12dd253ef13258750dca056d4b1219fc10 /tmp/agent.tar.gz
ADD --checksum=sha256:9205a704a980d5470495438bca4a5d5d17fb6b06ae218df58ae4d330cb137bd6 https://codeload.github.com/rancher/host-api/tar.gz/d56f3d0283c4910e9cc62d9123419f6caa2f9429 /tmp/host-api.tar.gz
COPY build-modern-packages.sh /tmp/build-modern-packages.sh
RUN --network=none sh /tmp/build-modern-packages.sh

FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS compose-executor
ENV GO111MODULE=off GOPATH=/go
WORKDIR /go/src/github.com/rancher/rancher-compose-executor
ADD --checksum=sha256:47d8a49a5529b1e2e631b59353fa30c4e86d8feef393c12670cf27db630591b2 https://codeload.github.com/rancher/rancher-compose-executor/tar.gz/5cefb3867ed8f6a98b2e0055ac12d6dfffff51a1 /tmp/compose-executor.tar.gz
COPY compose-executor-template.patch /tmp/
RUN --network=none tar -xzf /tmp/compose-executor.tar.gz --strip-components=1 && \
    git apply --unidiff-zero /tmp/compose-executor-template.patch && \
    go test -race -vet=off ./template/... && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/rancher-compose-executor .

FROM ${BACKEND_IMAGE}
COPY --from=packages /out/go-agent.tar.gz /usr/share/cattle/artifacts/go-agent.tar.gz
COPY --from=packages /out/host-api.tar.gz /usr/share/cattle/artifacts/host-api.tar.gz
COPY --from=packages /out/licenses/ /usr/share/doc/rancho-modern-agent/
COPY --from=compose-executor /out/rancher-compose-executor /usr/bin/rancher-compose-executor
COPY --from=compose-executor /go/src/github.com/rancher/rancher-compose-executor/LICENSE /usr/share/doc/rancho-compose-executor/LICENSE
